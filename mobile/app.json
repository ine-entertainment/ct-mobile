{
  "expo": {
    "name": "ClothTravel",
    "slug": "ct-mobile",
    "scheme": "ctmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ineentertainment.clothtravel",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "未命名项目",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryUsageDescription": "用于选择头像与旅行照片",
        "NSCameraUsageDescription": "用于拍摄旅行照片"
      }
    },
    "android": {
      "package": "com.ineentertainment.clothtravel",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF5EE"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/with-display-name",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF5EE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "http://192.168.50.84:3000/api"
    }
  }
}
