# Copy to .env and load with your process manager, or set these in the shell.
# The server itself does not read .env automatically (no dotenv dependency).
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/cloth-travel.db

# Local fake SMS
DEV_SMS_CODE=123456

# Local mock WeChat login
WECHAT_MOCK=true

# First-run admin account (existing database is not overwritten)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_HOURS=12
CUSTOMER_SESSION_DAYS=30
